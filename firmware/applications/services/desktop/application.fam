App(
    appid="desktop",
    name="DesktopSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="desktop_srv",
    cdefines=["SRV_DESKTOP"],
    requires=[
        "gui",
        "dolphin",
        "storage",
        "input",
    ],
    provides=["desktop_settings"],
    conflicts=["updater"],
    # R0N1N: the shell scenes scan the SD card (Captures, Search, Hub) on this thread.
    stack_size=3 * 1024,
    order=60,
)
